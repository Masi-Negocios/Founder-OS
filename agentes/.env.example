# Copie para agentes/.env e preencha. Nunca versione o .env.

# Chaves de acesso à API (obrigatório quando o servidor fica exposto na rede).
# Formato: chave:dono,chave:dono. Cada dono tem suas conversas e seu perfil do negócio.
FOUNDERS_AGENTES_CHAVES=troque-esta-chave:minha-empresa

# Modelo padrão (provedor:modelo) e modelos de reserva, separados por vírgula.
FOUNDERS_AGENTES_MODELO=anthropic:claude-opus-5-5
FOUNDERS_AGENTES_RESERVA=

# Preencha só os provedores que for usar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# 1 liga a execução dos scripts Python das skills (planilhas etc.). Só em container.
FOUNDERS_AGENTES_SCRIPTS=0
